{
  "manifest_version": 3,
  "name": "RIS Data Sender",
  "version": "1.1.4",
  "description": "Reads operation data from the active RIS form and sends it to the same OR SMART SSI server.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "http://10.154.104.165/*",
    "https://10.154.104.165/*",
    "http://localhost:9000/*",
    "http://localhost:5173/*"
  ],
  "action": {
    "default_title": "RIS Data Sender",
    "default_popup": "popup.html"
  }
}
